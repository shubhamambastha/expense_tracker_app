# Supabase project the app signs in with (Supabase Auth). Copy to .env (gitignored).
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
# Bypasses RLS. Used only by DELETE /v1/account to remove the auth user. Never ship it in the app.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
PORT=3000
