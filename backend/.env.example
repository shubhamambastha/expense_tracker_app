# Supabase project the app signs in with (Supabase Auth). Copy to .env (gitignored).
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
# Bypasses RLS. Used only by DELETE /v1/account to remove the auth user. Never ship it in the app.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# Export Data emails CSVs through Resend (resend.com). Without these, POST /v1/data/export answers 503.
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. "Expense Tracker <export@yourdomain.com>".
EXPORT_FROM_EMAIL=
PORT=3000
